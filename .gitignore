# Secrets & local overrides
.env
.env.local
.env.*.local

# Zip files
*.zip

# migrations files
migrations/*

# database files
database/*
!database/.htaccess

# Uploaded images (optional — keep if you don't want binaries in git)
uploads/*
!uploads/.htaccess

# debug logs (never commit)
logs/
*.log
!logs/.htaccess
!logs/index.php

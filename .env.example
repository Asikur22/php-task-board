# Task Board — environment config (DO NOT commit real secrets to public repos)
# Copy to .env and fill in values. .env is blocked from HTTP via .htaccess.

# Public URL of this app (no trailing slash). Required in production for email links.
# Example: https://greenlifeit.com/task-board
APP_BASE_URL=

# Auth policy
ALLOW_OPEN_REGISTRATION=true

# Login session length in seconds (cookie + server GC). Default 15552000 = 6 months.
SESSION_LIFETIME=15552000

# How often the browser checks for new notifications (seconds). Default 2. Range 1–300.
NOTIFICATION_POLL_SECONDS=2

# General debug logging (e.g. AI Chat → logs/ai-chat-YYYY-MM-DD.log). Keep false in production.
DEBUG=false

# Set true only behind a trusted reverse proxy (uses X-Forwarded-*).
TRUST_PROXY=false

# SMTP (Titan Email / Hostinger)
MAIL_MAILER=smtp
MAIL_HOST=smtp.titan.email
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | none  (Titan on 587 needs tls / STARTTLS)
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Task Board"
